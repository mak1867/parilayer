# Copy to .env and fill in. Never commit .env or anything in keys/.
# Paths to local keypair files (created with solana-keygen, kept in keys/, which is git-ignored).
SOLANA_RPC_URL=https://api.devnet.solana.com
ADMIN_KEYPAIR=./keys/admin.json
ORACLE_KEYPAIR=./keys/oracle.json
USDC_MINT_KEYPAIR=./keys/usdc-mint.json

# Relayer
RELAYER_PORT=8787
SEED_USDC=500
# GEMINI_MOCK=1            # serve Gemini data from relayer/fixtures instead of the network
# MIRROR_CONFIG=relayer/config/mirror.json
# RELAYER_DATA_DIR=relayer/data

# RFQ service (secondary market) and the optional quoter bot
RFQ_PORT=8788
# RFQ_DATA_DIR=rfq/data
# BOT_KEYPAIR=./keys/bot.json
